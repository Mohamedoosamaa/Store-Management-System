<UserControl x:Class="StoreManagementSystem.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:StoreManagementSystem.ViewModels">

    <!-- ================= DATACONTEXT ================= -->

    <UserControl.DataContext>
        <viewModels:ProductViewModel/>
    </UserControl.DataContext>

    <!-- ================= UI ================= -->

    <Grid Background="#F1F5F9">

        <StackPanel Margin="25">

            <!-- ================= HEADER ================= -->

            <Border Background="White"
                    CornerRadius="12"
                    Padding="25"
                    Margin="0 0 0 20">

                <StackPanel>

                    <TextBlock Text="Inventory Dashboard"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Monitor stock and inventory status"
                               Foreground="Gray"
                               Margin="0 8 0 0"/>

                </StackPanel>

            </Border>

            <!-- ================= STATS ================= -->

            <WrapPanel Margin="0 0 0 20">

                <!-- TOTAL PRODUCTS -->

                <Border Background="White"
                        Width="220"
                        Height="100"
                        CornerRadius="10"
                        Margin="0 0 20 0"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="Total Products"
                                   Foreground="Gray"/>

                        <TextBlock Text="{Binding TotalProducts}"
                                   FontSize="36"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </Border>

                <!-- LOW STOCK -->

                <Border Background="White"
                        Width="220"
                        Height="100"
                        CornerRadius="10"
                        Margin="0 0 20 0"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="Low Stock"
                                   Foreground="Gray"/>

                        <TextBlock Text="{Binding LowStockCount}"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="Red"/>

                    </StackPanel>

                </Border>

                <!-- INVENTORY VALUE -->

                <Border Background="White"
                        Width="220"
                        Height="100"
                        CornerRadius="10"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="Inventory Value"
                                   Foreground="Gray"/>

                        <TextBlock Text="{Binding InventoryValue,
                                   StringFormat={}{0:C}}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"/>

                    </StackPanel>

                </Border>

            </WrapPanel>

            <!-- ================= SEARCH ================= -->

            <Border Background="White"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0 0 0 20">

                <Grid HorizontalAlignment="Center">

                    <Grid>

                        <!-- SEARCH BOX -->

                        <TextBox x:Name="SearchBox"
                                 Width="350"
                                 Height="42"
                                 FontSize="15"
                                 Padding="15 0"
                                 Background="#F8FAFC"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SearchText,
                                 UpdateSourceTrigger=PropertyChanged}">

                            <TextBox.Resources>

                                <Style TargetType="Border">

                                    <Setter Property="CornerRadius"
                                            Value="8"/>

                                </Style>

                            </TextBox.Resources>

                        </TextBox>

                        <!-- PLACEHOLDER -->

                        <TextBlock Text="Search products..."
                                   Margin="15 0"
                                   Foreground="Gray"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding Text,
                                                ElementName=SearchBox}"
                                                     Value="">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                </Grid>

            </Border>

            <!-- ================= PRODUCTS TABLE ================= -->

            <Border Background="White"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Inventory Items"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0 0 0 15"/>

                    <DataGrid ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              RowHeight="45"
                              FontSize="14"
                              GridLinesVisibility="None">

                        <!-- HEADER STYLE -->

                        <DataGrid.ColumnHeaderStyle>

                            <Style TargetType="DataGridColumnHeader">

                                <Setter Property="Background"
                                        Value="#1E293B"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                                <Setter Property="FontWeight"
                                        Value="Bold"/>

                                <Setter Property="Height"
                                        Value="40"/>

                            </Style>

                        </DataGrid.ColumnHeaderStyle>

                        <!-- COLUMNS -->

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Product"
                                                Binding="{Binding Name}"
                                                Width="*"/>

                            <DataGridTextColumn Header="SKU"
                                                Binding="{Binding SKU}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Price"
                                                Binding="{Binding Price,
                                                StringFormat={}{0:C}}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Stock"
                                                Binding="{Binding StockQuantity}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Value"
                                                Binding="{Binding TotalValue,
                                                StringFormat={}{0:C}}"
                                                Width="*"/>

                        </DataGrid.Columns>

                        <!-- LOW STOCK ALERT -->

                        <DataGrid.RowStyle>

                            <Style TargetType="DataGridRow">

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsLowStock}"
                                                 Value="True">

                                        <Setter Property="Background"
                                                Value="#FECACA"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </DataGrid.RowStyle>

                    </DataGrid>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>

</UserControl>