<Window x:Class="StoreManagementSystem.Views.TransactionDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transaction Details"
        Height="650"
        Width="750">

    <Grid Background="#F1F5F9">
        <StackPanel Margin="25">

            <Border Background="White" CornerRadius="12" Padding="25" Margin="0 0 0 20">
                <StackPanel>
                    <TextBlock Text="{Binding Id, StringFormat=Transaction \#{0}}" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="Gray" Margin="0 8 0 0"/>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0 0 0 20">

                <Border Background="White" Width="200" Height="100" CornerRadius="10" Margin="0 0 20 0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Items" Foreground="Gray"/>
                        <TextBlock Text="{Binding ItemCount}" FontSize="36" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Width="200" Height="100" CornerRadius="10" Margin="0 0 20 0" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Status" Foreground="Gray"/>
                        <TextBlock Text="{Binding Status}" FontSize="22" FontWeight="Bold" Foreground="#2563EB"/>
                    </StackPanel>
                </Border>

                <Border Background="White" Width="200" Height="100" CornerRadius="10" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Total" Foreground="Gray"/>
                        <TextBlock Text="{Binding Total, StringFormat={}{0:C}}" FontSize="22" FontWeight="Bold" Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

            </WrapPanel>

            <Border Background="White" CornerRadius="12" Padding="20">
                <StackPanel>

                    <TextBlock Text="Items" FontSize="20" FontWeight="Bold" Margin="0 0 0 15"/>

                    <DataGrid ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" BorderThickness="0"
                              RowHeight="45" FontSize="14" GridLinesVisibility="None">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="40"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="*"/>
                            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat={}{0:C}}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:C}}" Width="*"/>
                        </DataGrid.Columns>

                    </DataGrid>

                    <StackPanel Margin="0 20 0 0">
                        <TextBlock Text="{Binding SubTotal, StringFormat=Subtotal: {0:C}}" FontSize="16" Margin="0 5"/>
                        <TextBlock Text="{Binding VAT, StringFormat=VAT: {0:C}}" FontSize="16" Margin="0 5"/>
                        <TextBlock Text="{Binding Total, StringFormat=Total: {0:C}}" FontSize="22" FontWeight="Bold" Margin="0 10"/>
                    </StackPanel>
                    <Button Content="Transaction History"
        Height="45"
        Margin="0 10 0 0"
        Background="#2563EB"
        Foreground="White"
        FontWeight="Bold"
        Click="TransactionHistoryBtn_Click"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>

</Window>